# --- LLM ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=180
LLM_TEMPERATURE=0.0
# Optional; never commit a real key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Chunking / retrieval ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5

# --- Storage ---
DATA_DIR=./data
LOG_LEVEL=INFO
